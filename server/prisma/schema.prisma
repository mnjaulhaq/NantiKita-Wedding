generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               Int       @id @default(autoincrement())
  name             String
  username         String    @unique
  email            String    @unique
  emailVerifiedAt  DateTime? @map("email_verified_at")
  password         String
  // Semua akun aplikasi saat ini adalah owner.
  role             String    @default("owner")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  weddings Wedding[]

  @@map("users")
}

model Otp {
  id        Int      @id @default(autoincrement())
  username  String
  otpCode   String   @map("otp_code")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("otps")
}

model Wedding {
  id            Int      @id @default(autoincrement())
  slug          String   @unique
  namaPria      String   @map("nama_pria")
  namaWanita    String   @map("nama_wanita")
  tanggalAcara  DateTime @map("tanggal_acara")
  lokasiAcara   String   @map("lokasi_acara")
  tema          String
  // "basic" | "premium" -- divalidasi di kode (Zod), SQLite tidak dukung enum native
  paket         String   @default("basic")
  musikUrl      String?  @map("musik_url")
  // Owner pemilik data ini. Semua akun saat ini ber-role owner.
  userId        Int?     @map("user_id")
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  rsvps Rsvp[]

  @@index([userId])
  @@map("weddings")
}

model Rsvp {
  id           Int        @id @default(autoincrement())
  weddingId    Int        @map("wedding_id")
  namaTamu     String     @map("nama_tamu")
  alamat       String
  jumlahHadir  Int        @default(1) @map("jumlah_hadir")
  // "hadir" | "tidak_hadir" -- divalidasi di kode (Zod), SQLite tidak dukung enum native
  status       String
  ucapan       String?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  wedding Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@map("rsvps")
}
