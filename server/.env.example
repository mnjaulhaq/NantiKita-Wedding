# Salin file ini menjadi .env lalu sesuaikan nilainya. Jangan commit .env.
DATABASE_URL="mysql://root@127.0.0.1:3306/nantikita_wedding"

# WAJIB sama persis dengan JWT_SECRET di client/.env.local
JWT_SECRET="ganti-dengan-string-acak-panjang"

CLIENT_ORIGIN="http://localhost:3000"
PORT=4000

# SMTP opsional. Kalau SMTP_HOST kosong, kode OTP hanya dicetak di console server (mode dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NantiKita <no-reply@nantikita.test>"